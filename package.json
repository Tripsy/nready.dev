{
	"name": "sample-node-api",
	"version": "1.0.0",
	"description": "Sample API",
	"keywords": [
		"node",
		"api",
		"typescript"
	],
	"author": "Gabriel David",
	"license": "GNU",
	"homepage": "https://github.com/Tripsy/nready.dev#readme",
	"bugs": {
		"url": "https://github.com/Tripsy/nready.dev/issues"
	},
	"main": "server.js",
	"type": "module",
	"scripts": {
		"dev": "nodemon",
		"build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tsx cli/copy-build-assets.ts",
		"start": "cd dist && APP_ENV=production NODE_ENV=production node src/server.js",
		"test": "NODE_OPTIONS=--experimental-vm-modules APP_DEBUG=false APP_ENV=test NODE_ENV=test jest",
		"typecheck": "tsc --noEmit",
		"biome": "NODE_OPTIONS=--no-deprecation biome check --write",
		"messages:check": "tsx cli/check-message-keys.ts",
		"migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d ./src/config/data-source.config.ts",
		"migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d ./src/config/data-source.config.ts",
		"migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d ./src/config/data-source.config.ts"
	},
	"dependencies": {
		"@aws-sdk/client-cloudwatch-logs": "^3.1096.0",
		"@aws-sdk/client-ses": "^3.1096.0",
		"@aws-sdk/credential-provider-node": "^3.972.73",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.81.2",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dayjs": "^1.11.21",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.1",
		"file-stream-rotator": "^1.0.0",
		"helmet": "^8.3.0",
		"ioredis": "^5.11.1",
		"jsonwebtoken": "^9.0.3",
		"mysql2": "^3.23.2",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.0.3",
		"nunjucks": "^3.2.4",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"pino-abstract-transport": "^3.0.0",
		"qs": "^6.15.3",
		"reflect-metadata": "^0.2.2",
		"sanitize-html": "^2.17.6",
		"typeorm": "^1.1.0",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@jest/globals": "^30.4.1",
		"@types/bcrypt": "^6.0.0",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.13.3",
		"@types/node-cron": "^3.0.11",
		"@types/nodemailer": "^8.0.1",
		"@types/nunjucks": "^3.2.6",
		"@types/qs": "^6.15.1",
		"@types/sanitize-html": "^2.16.1",
		"@types/supertest": "^7.2.1",
		"commander": "^15.0.0",
		"jest": "^30.4.2",
		"mailtrap": "^4.8.0",
		"node-mocks-http": "^1.18.1",
		"nodemon": "^3.1.14",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"tsc-alias": "^1.9.1",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	},
	"nodemonConfig": {
		"watch": [
			"src"
		],
		"ext": "ts,json",
		"exec": "tsx ./src/server.ts"
	}
}
