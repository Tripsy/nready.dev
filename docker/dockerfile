FROM node:24

WORKDIR /var/www/html

# Set the working directory
WORKDIR /var/www/html

# Set the SHELL environment variable
ENV SHELL=/bin/bash

# Install pnpm
RUN wget -qO- https://get.pnpm.io/install.sh | sh -

# pnpm 11 puts its binaries in $PNPM_HOME/bin; pnpm 10 and earlier put them directly in
# $PNPM_HOME. Both are on PATH so the image builds either way.
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"

# Init
RUN pnpm init

# Dev port, matching the mapping in docker-compose.yml. Production runs on 80.
EXPOSE 3000

# Define the command to run your application
# CMD ["pnpm", "run", "dev"]
